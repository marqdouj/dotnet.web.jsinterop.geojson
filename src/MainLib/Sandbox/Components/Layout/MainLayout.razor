@inherits LayoutComponentBase

<FluentLayout>
    <FluentLayoutItem Area="LayoutArea.Header">
        <FluentLayoutHamburger />
        <FluentText Weight="TextWeight.Bold" Size="TextSize.Size600">@header</FluentText>
    </FluentLayoutItem>
    <FluentLayoutItem Area="LayoutArea.Navigation">
        <NavMenu />
    </FluentLayoutItem>
    <FluentLayoutItem Area="LayoutArea.Content" Class="main">
        <div class="content">
            @Body
        </div>
    </FluentLayoutItem>

    <FluentLayoutItem Area="LayoutArea.Footer">
        <div style="display: flex">
            <FluentLink Href="@LinkExtensions.LearnBlazor" Target="LinkTarget.Blank" IconEnd="@(new Icons.Regular.Size16.ArrowExit())">
                Blazor
            </FluentLink>
            <FluentSpacer />
            <FluentLink Href="@LinkExtensions.GitHub" Target="LinkTarget.Blank" IconEnd="@(new Icons.Regular.Size16.ArrowExit())">
                @LinkExtensions.Copyright
            </FluentLink>
            <FluentSpacer />
            <FluentLink Href="@LinkExtensions.FluentBlazor" Target="LinkTarget.Blank" IconEnd="@(new Icons.Regular.Size16.ArrowExit())">
                Fluent Blazor
            </FluentLink>
        </div>
    </FluentLayoutItem>
</FluentLayout>

<FluentProviders @rendermode="InteractiveServer" />

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private string header = "GeoJSON JSInterop";
}